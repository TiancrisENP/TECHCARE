# PostgreSQL (local Docker)
# DATABASE_URL="postgresql://techcare:techcare@localhost:5432/techcare?schema=public"
# DIRECT_URL="postgresql://techcare:techcare@localhost:5432/techcare?schema=public"
#
# Supabase → Connect → ORM → Prisma: pega las dos líneas postgresql://
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@HOST:5432/postgres"

# JWT
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-tambien-por-otro-secreto-aleatorio"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS - dominio del frontend (Vercel)
FRONTEND_URL="http://localhost:3000"
