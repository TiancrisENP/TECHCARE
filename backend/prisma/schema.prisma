// =====================================================================
// TECHCARE - Prisma Schema
// Sistema de gestión: ventas + inventario + servicio técnico + garantías
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  ADMIN
  VENDEDOR
  TECNICO
  CLIENTE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOCK
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum ServiceStatus {
  RECIBIDO
  DIAGNOSTICO
  COTIZACION
  ESPERANDO_APROBACION
  EN_REPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum WarrantyStatus {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
  SOLUCIONADA
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

// ---------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENTE)
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[] @relation("OrderCustomer")
  salesAsSeller  Order[] @relation("OrderSeller")
  salesAsTech    Order[] @relation("OrderTechnician")
  services       Service[] @relation("ClienteServices")
  techJobs       Service[] @relation("TecnicoServices")
  warranties     Warranty[]
  auditLogs      AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------
// CATALOG / INVENTORY
// ---------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  description String?
  brand       String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  price       Decimal  @db.Decimal(12, 2)
  salePrice   Decimal? @db.Decimal(12, 2)
  minPrice    Decimal? @db.Decimal(12, 2)
  cost        Decimal  @db.Decimal(12, 2)
  supplier    String?
  stock       Int      @default(0)
  minStock    Int      @default(2)
  imageUrl    String?
  warrantyMonths Int   @default(12)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  warranties         Warranty[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String  @unique
  price     Decimal @db.Decimal(12, 2)
  salePrice Decimal? @db.Decimal(12, 2)
  minPrice  Decimal? @db.Decimal(12, 2)
  stock     Int     @default(0)
  imageUrl  String?
  active    Boolean @default(true)

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@map("product_variants")
}

model InventoryMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  type      MovementType
  quantity  Int
  reason    String?
  createdAt DateTime     @default(now())

  @@map("inventory_movements")
}

// ---------------------------------------------------------------------
// SALES
// ---------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  customerId    String
  customer      User          @relation("OrderCustomer", fields: [customerId], references: [id])
  sellerId      String
  seller        User          @relation("OrderSeller", fields: [sellerId], references: [id])
  technicianId  String?
  technician    User?         @relation("OrderTechnician", fields: [technicianId], references: [id])
  status        OrderStatus   @default(PENDIENTE)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  warranties Warranty[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  serialNumber String?

  @@map("order_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------
// TECHNICAL SERVICE
// ---------------------------------------------------------------------

model Service {
  id            String        @id @default(cuid())
  trackingCode  String        @unique // ej TRK-92831
  customerId    String
  customer      User          @relation("ClienteServices", fields: [customerId], references: [id])
  technicianId  String?
  technician    User?         @relation("TecnicoServices", fields: [technicianId], references: [id])
  deviceName    String
  serialNumber  String?
  problem       String
  diagnosis     String?
  quotedAmount  Decimal?      @db.Decimal(12, 2)
  status        ServiceStatus @default(RECIBIDO)
  receivedAt    DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  statusHistory ServiceStatusHistory[]

  @@map("services")
}

model ServiceStatusHistory {
  id        String        @id @default(cuid())
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  status    ServiceStatus
  note      String?
  changedAt DateTime      @default(now())

  @@map("service_status_history")
}

// ---------------------------------------------------------------------
// WARRANTIES
// ---------------------------------------------------------------------

model Warranty {
  id          String         @id @default(cuid())
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  customerId  String
  customer    User           @relation(fields: [customerId], references: [id])
  problem     String
  status      WarrantyStatus @default(PENDIENTE)
  purchaseDate DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  evidence WarrantyEvidence[]

  @@map("warranties")
}

model WarrantyEvidence {
  id         String   @id @default(cuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id])
  imageUrl   String
  createdAt  DateTime @default(now())

  @@map("warranty_evidence")
}

// ---------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // ej "PRODUCT_UPDATED", "WARRANTY_STATUS_CHANGED"
  entity    String   // ej "Product", "Warranty"
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// SOCIAL / CONTACT BUBBLES
// ---------------------------------------------------------------------

enum SocialNetwork {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  TELEGRAM
  OTRO
}

model SocialLink {
  id        String        @id @default(cuid())
  network   SocialNetwork
  label     String
  url       String
  iconUrl   String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("social_links")
}
